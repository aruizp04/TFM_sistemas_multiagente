<launch>
  <arg name="use_sim_time" default="true"/>

  <!-- Common launch -->
  <include file="$(find-pkg-share rmf_demos)/common.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="viz_config_file" value ="$(find-pkg-share my_world)/rviz/my_world.rviz"/>
    <arg name="config_file" value="$(find-pkg-share my_world)/maps/my_world/my_world.building.yaml"/>
  </include>

  <!-- TinyRobot fleet adapter. It publishes tinyRobot1 to RMF/RViz. -->
  <include file="$(find-pkg-share rmf_demos_fleet_adapter)/launch/fleet_adapter.launch.xml">
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="nav_graph_file" value="$(find-pkg-share my_world)/maps/my_world/nav_graphs/0.yaml"/>
    <arg name="config_file" value="$(find-pkg-share my_world)/config/tinyRobot_config.yaml"/>
  </include>

  <!-- Mundo RMF -->
  <include file="$(find-pkg-share rmf_demos_gz)/simulation.launch.xml">
    <arg name="map_package" value="my_world"/>
    <arg name="map_name" value="my_world"/>
    <arg name="headless" value="false"/>
  </include>

  <!-- Spawn del primer TurtleBot4 -->
  <include file="$(find-pkg-share my_world)/launch/turtlebot4_spawn.launch.py">
    <arg name="namespace" value="turtlebot1"/>
    <arg name="robot_name" value="turtlebot1"/>
    <arg name="dock_name" value="turtlebot1_standard_dock"/>
    <arg name="model" value="lite"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="rviz" value="false"/>
    <arg name="slam" value="false"/>
    <arg name="localization" value="false"/>
    <arg name="nav2" value="false"/>
    <arg name="x" value="46.19"/>
    <arg name="y" value="-19.95"/>
    <arg name="z" value="0.2"/>
    <arg name="yaw" value="1.52"/>
  </include>

  <!-- Spawn del segundo TurtleBot4 -->
  <include file="$(find-pkg-share my_world)/launch/turtlebot4_spawn.launch.py">
    <arg name="namespace" value="turtlebot2"/>
    <arg name="robot_name" value="turtlebot2"/>
    <arg name="dock_name" value="turtlebot2_standard_dock"/>
    <arg name="model" value="lite"/>
    <arg name="use_sim_time" value="$(var use_sim_time)"/>
    <arg name="rviz" value="false"/>
    <arg name="slam" value="false"/>
    <arg name="localization" value="false"/>
    <arg name="nav2" value="false"/>
    <arg name="x" value="46.75"/>
    <arg name="y" value="-3.72"/>
    <arg name="z" value="0.2"/>
    <arg name="yaw" value="1.52"/>
  </include>

  <!-- Localización/Nav2 se retrasan para que ros2_control publique odometría. -->
  <timer period="12.0">
    <!-- Localización con mapa del primer TurtleBot4 -->
    <include file="$(find-pkg-share turtlebot4_navigation)/launch/localization.launch.py">
      <arg name="namespace" value="turtlebot1"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="map" value="$(find-pkg-share my_world)/maps/my_world/plano_my_office.yaml"/>
    </include>

    <!-- Nav2 del primer TurtleBot4 -->
    <include file="$(find-pkg-share turtlebot4_navigation)/launch/nav2.launch.py">
      <arg name="namespace" value="turtlebot1"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>

    <!-- Localización con mapa del segundo TurtleBot4 -->
    <include file="$(find-pkg-share turtlebot4_navigation)/launch/localization.launch.py">
      <arg name="namespace" value="turtlebot2"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
      <arg name="map" value="$(find-pkg-share my_world)/maps/my_world/plano_my_office.yaml"/>
    </include>

    <!-- Nav2 del segundo TurtleBot4 -->
    <include file="$(find-pkg-share turtlebot4_navigation)/launch/nav2.launch.py">
      <arg name="namespace" value="turtlebot2"/>
      <arg name="use_sim_time" value="$(var use_sim_time)"/>
    </include>
  </timer>
</launch>
